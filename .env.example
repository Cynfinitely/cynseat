# Copy to .env.local for development. Never commit real values.

# Public base URL of the app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Postgres. `pnpm db:up` starts one in Docker on port 5433 with these credentials.
DATABASE_URL=postgres://cynseat:cynseat@localhost:5433/cynseat

# Signs sessions and tokens. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Signs order links and ticket QR codes. Generate one with: openssl rand -base64 32
# Changing it later invalidates every link and ticket already issued.
SIGNING_SECRET=

# "fake" uses a built-in stand-in for the payment provider (development and tests only).
PAYMENTS_DRIVER=fake

# Needed when PAYMENTS_DRIVER=stripe. The webhook endpoint is /api/webhooks/payments and
# must listen to events on connected accounts.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# CynSeat's fee on paid orders. 0 means organizations keep everything except card fees.
PLATFORM_FEE_BPS=0
PLATFORM_FEE_FIXED_MINOR=0

# "console" prints emails to the server log; "resend" sends them and needs the two values below.
MAIL_DRIVER=console
RESEND_API_KEY=
EMAIL_FROM="CynSeat <no-reply@localhost>"

# Protects /api/cron/*. Set the same value in Vercel so its cron jobs are accepted.
# Generate one with: openssl rand -base64 32
CRON_SECRET=

# Where uploaded posters are kept. "local" writes to .data/uploads on this machine;
# "vercel-blob" is for deployments and needs BLOB_READ_WRITE_TOKEN.
STORAGE_DRIVER=local
BLOB_READ_WRITE_TOKEN=
