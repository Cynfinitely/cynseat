{
  "name": "cynseat",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@vercel/blob": "^2.8.1",
    "better-auth": "1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.4",
    "lucide-react": "^1.55.0",
    "next": "16.4.0",
    "next-intl": "^4.14.9",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.90.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testcontainers/postgresql": "^12.2.0",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.4",
    "dotenv": "^18.0.7",
    "drizzle-kit": "0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.4"
  },
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:all": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check:messages": "tsx scripts/check-messages.ts",
    "db:up": "scripts/dev-db.sh up",
    "db:down": "scripts/dev-db.sh down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:check": "drizzle-kit check",
    "db:reset": "scripts/dev-db.sh reset",
    "auth:generate": "pnpm dlx auth@1.7.7 generate --config src/server/auth/cli.ts --output src/server/db/schema/auth.ts -y && prettier --write src/server/db/schema/auth.ts",
    "admin:grant": "tsx scripts/grant-platform-admin.ts",
    "db:seed": "tsx scripts/seed.ts"
  }
}
